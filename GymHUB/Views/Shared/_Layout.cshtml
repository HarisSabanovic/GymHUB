<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GymHUB</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="site-nav">
            <a class="site-logo" asp-area="" asp-controller="Home" asp-action="Index">GymHUB</a>

            <div class="site-links">
                <a asp-controller="Home" asp-action="Index">Hem</a>
                <a asp-controller="ClassSessions" asp-action="Index">Pass</a>

                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    <a asp-controller="Bookings" asp-action="My">Mina bokningar</a>
                }

                @if (User.IsInRole("Admin"))
                {
                 
                    <button class="btn btn-primary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                        Admin
                    </button>

                    <ul class="dropdown-menu">
                        <li>
                            <a class="dropdown-item text-black" asp-controller="AdminBookings" asp-action="Index">
                                Bokningar
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item text-black" asp-controller="AdminClassSessions" asp-action="Index">
                                Pass
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item text-black" asp-controller="AdminRooms" asp-action="Index">
                                Salar
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item text-black" asp-controller="AdminInstructors" asp-action="Index">
                                Instruktörer
                            </a>
                        </li>
                    </ul>
                }
            </div>

            <div class="site-auth">
                <partial name="_LoginPartial" />
            </div>
        </nav>
    </header>

    <main class="site-main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <p>&copy; 2026 GymHUB</p>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>